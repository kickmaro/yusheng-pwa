# 穩定 demo 建議先用 openai；省成本測中文可改 google、openrouter 或 groq。
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini

# Google Gemini 免費額度適合早期試用。
GOOGLE_API_KEY=your-google-ai-studio-key-here
GOOGLE_MODEL=gemini-2.5-flash

# OpenRouter 可先用 openrouter/free 測免費路由，再到 OpenRouter Models 頁挑 Qwen 的 :free 模型。
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openrouter/free

# Groq 免費層速度快；若模型名稱異動，以 Groq Console 顯示為準。
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=qwen-qwq-32b
